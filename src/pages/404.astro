---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '페이지를 찾지 못했습니다';
---

<BaseLayout title={title} description="요청한 주소에 페이지가 없습니다." noindex>
  <header class="page-intro">
    <p class="eyebrow">404</p>
    <h1>{title}</h1>
    <p>주소가 바뀌었거나 글이 삭제됐을 수 있습니다.</p>
    <p><a href="/">홈으로 돌아가기</a> · <a href="/search/">글 검색</a></p>
  </header>
</BaseLayout>
