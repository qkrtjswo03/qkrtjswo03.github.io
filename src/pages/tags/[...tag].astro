---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../../components/Cmd.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupPostsByTag, tagPath } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const groups = groupPostsByTag(posts);
  const paths: Array<{
    params: { tag: string };
    props: { kind: 'page' | 'redirect'; label: string; tagged: typeof posts; target?: string };
  }> = [];
  const seen = new Set<string>();

  for (const group of groups) {
    if (!seen.has(group.slug)) {
      seen.add(group.slug);
      paths.push({
        params: { tag: group.slug },
        props: { kind: 'page', label: group.label, tagged: group.posts },
      });
    }
    for (const alias of group.aliases) {
      if (alias !== group.slug && !seen.has(alias)) {
        seen.add(alias);
        paths.push({
          params: { tag: alias },
          props: { kind: 'redirect', label: group.label, tagged: [], target: tagPath(group.slug) },
        });
      }
    }
  }

  return paths;
}

const { kind, label, tagged, target } = Astro.props;
if (kind === 'redirect' && target) {
  return Astro.redirect(target, 301);
}
---

<BaseLayout title={label} description={`${label} 태그가 달린 글 ${tagged.length}편입니다.`} source="src/pages/tags/[...tag].astro">
  <header class="page-intro">
    <Cmd command={`kubectl get posts -l tag=${label}`} />
    <h1>{label}</h1>
    <p>{tagged.length}개의 글</p>
  </header>
  <PostList posts={tagged} />
</BaseLayout>
