---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import { site } from '../config';

const notionUrl =
  'https://app.notion.com/p/sun-jae/b1d8cb1197ef40e2b4363133661d930b?v=31ba1d54a53e8093bec7000c315ecccf';

const certifications = [
  {
    name: 'CKAD',
    full: 'Certified Kubernetes Application Developer',
    org: 'CNCF',
    issued: '2023.04.30',
    image: '/certs/ckad.png',
  },
  { name: 'CKA', full: 'Certified Kubernetes Administrator', org: 'CNCF', issued: '2023.02.26', image: '/certs/cka.png' },
  {
    name: 'NCP',
    full: 'Naver Cloud Platform Certified Professional',
    org: 'NAVER CLOUD PLATFORM',
    issued: '2022.08.04',
    image: '/certs/ncp.png',
  },
  {
    name: 'NCA',
    full: 'Naver Cloud Platform Certified Associate',
    org: 'NAVER CLOUD PLATFORM',
    issued: '2022.07.20',
    image: '/certs/nca.png',
  },
  { name: '컴퓨터활용능력 2급', full: '', org: '대한상공회의소', issued: '2021.05.24' },
  { name: '운전면허증 1종 보통', full: '', org: '울산경찰청', issued: '2014.12.17' },
];

const education = [
  { school: '울산대학교', major: 'IT융합학과', kind: '학사', from: '2020.03', to: '2022.02', status: '졸업' },
  { school: '동의과학대학교', major: '컴퓨터정보학과', kind: '전문학사', from: '2015.03', to: '2020.02', status: '졸업' },
  { school: '울산고등학교', major: '', kind: '고등학교', from: '2012.03', to: '2015.02', status: '졸업' },
];
---

<BaseLayout title="소개" description="SunJae.Log를 쓰는 사람과 이 블로그가 다루는 범위입니다.">
  <article class="prose prose-page">
    <header class="page-intro">
      <Cmd command="kubectl describe engineer" />
      <h1>소개</h1>
    </header>
    <section class="describe-panel" aria-label="엔지니어">
      <dl class="describe-list">
        <div>
          <dt>Name</dt>
          <dd>박선재 <span class="muted">SunJae Park</span></dd>
        </div>
        <div>
          <dt>Handle</dt>
          <dd><code>{site.author}</code></dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>Cloud-Native Platform Engineer <span class="muted">클라우드 네이티브 플랫폼 엔지니어</span></dd>
        </div>
        <div>
          <dt>Labels</dt>
          <dd class="chip-row">
            <span class="label-chip">kubernetes</span>
            <span class="label-chip">observability</span>
            <span class="label-chip">istio</span>
          </dd>
        </div>
        <div>
          <dt>Notion</dt>
          <dd>
            <a href={notionUrl} rel="me noopener" target="_blank">이력서 · 포트폴리오</a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>
            {
              site.email.map((address) => (
                <div>
                  <a href={`mailto:${address}`}>{address}</a>
                </div>
              ))
            }
          </dd>
        </div>
      </dl>
    </section>
    <p>
      클라우드와 인프라를 운영하며 남는 기록입니다. Kubernetes 위에서 서비스를 올리고, 메트릭과 로그로 상태를
      보고, 장애가 나면 원인을 좁히는 일을 합니다. 최근에는 그 과정에 LLM을 어디까지 끼워 넣을 수 있는지도 같이
      봅니다.
    </p>
    <p>
      이 블로그는 그 작업 메모를 다음에 그대로 쓸 수 있게 정리하는 곳입니다. 주제는 글마다 붙이고, 나중에 늘어나도
      주소 체계는 그대로 둡니다. 해본 프로젝트는 <a href="/projects/">프로젝트</a>에 모아 두었습니다.
    </p>
    <h2>주로 다루는 것</h2>
    <ul>
      <li>Kubernetes와 배포</li>
      <li>관측 가능성. 메트릭, 로그, 트레이스</li>
      <li>장애 원인 분석</li>
      <li>LLM을 곁들인 운영</li>
    </ul>
    <h2 id="certs">자격사항</h2>
    <ul class="record-cards">
      {
        certifications.map((item) => (
          <li class={`record-card${item.image ? ' record-card--with-image' : ''}`}>
            {item.image && (
              <span class="record-thumb">
                <img src={item.image} alt={`${item.name} 자격증`} loading="lazy" decoding="async" />
              </span>
            )}
            <span class="record-body">
              <span class="record-name">{item.name}</span>
              {item.full && <span class="record-sub">{item.full}</span>}
              <span class="record-meta">
                <span class="record-org">{item.org}</span>
                <time class="record-date">{item.issued}</time>
              </span>
            </span>
          </li>
        ))
      }
    </ul>
    <h2>학력사항</h2>
    <ol class="timeline">
      {
        education.map((item) => (
          <li class="timeline-item">
            <span class="timeline-year">{item.to.slice(0, 4)}</span>
            <span class="timeline-rail" aria-hidden="true" />
            <span class="timeline-body">
              <span class="timeline-title">{item.school}</span>
              <span class="timeline-sub">{item.kind}{item.major ? ` · ${item.major}` : ''}</span>
              <span class="timeline-meta">
                {item.from} – {item.to}
                <span class="timeline-status">{item.status}</span>
              </span>
            </span>
          </li>
        ))
      }
    </ol>
    <p>
      자격과 학력 전체는 <a href={notionUrl} rel="me noopener" target="_blank">Notion 이력서</a>에서도 볼 수 있습니다.
    </p>
    <h2>이 사이트</h2>
    <p>
      GitHub Pages에 올라가는 정적 사이트입니다. 새 글은 Markdown 파일 하나를 추가하면 생깁니다.
    </p>
    <p>
      운영자: {site.author}<br />
      연락:{' '}
      {
        site.email.map((address, index) => (
          <>
            {index > 0 && ' · '}
            <a href={`mailto:${address}`}>{address}</a>
          </>
        ))
      }
    </p>
    <p>소개 문구는 <code>src/pages/about.astro</code>에서 고칩니다.</p>
  </article>
</BaseLayout>
