---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const publicCount = posts.filter((post) => !post.data.locked).length;
---

<BaseLayout title="검색" description="제목, 본문, 주제, 태그로 글을 찾습니다." source="src/pages/search.astro">
  <header class="page-intro">
    <Cmd command="grep -i" />
    <h1>글 검색</h1>
    <p id="search-count">{publicCount}개의 글에서 제목·본문·주제·태그로 찾습니다. 본문 색인은 처음 검색할 때 불러옵니다.</p>
  </header>
  <form class="search-form" role="search">
    <label class="sr-only" for="q">검색어</label>
    <div class="search-line">
      <span class="ps1" aria-hidden="true">
        <span class="ps1-user">sunjae</span><span class="ps1-at">@</span><span class="ps1-host">k8s</span><span class="ps1-path">:~</span><span class="ps1-sigil">$</span>
      </span>
      <input id="q" name="q" type="search" placeholder="제목, 본문, 태그" autocomplete="off" enterkeyhint="search" />
    </div>
  </form>
  <p id="search-empty" class="empty" hidden>일치하는 글이 없습니다.</p>
  <PostList posts={posts} searchable />
</BaseLayout>

<script>
  type SearchDoc = { url: string; title: string; description: string; categories: string[]; tags: string[]; body: string };

  const form = document.querySelector<HTMLFormElement>('.search-form');
  const input = document.querySelector<HTMLInputElement>('#q');
  const items = [...document.querySelectorAll<HTMLElement>('#results tr')];
  const empty = document.querySelector<HTMLElement>('#search-empty');
  const count = document.querySelector<HTMLElement>('#search-count');

  let bodyIndex: SearchDoc[] | null = null;
  let bodyIndexPromise: Promise<SearchDoc[]> | null = null;

  const loadIndex = () => {
    if (bodyIndex) return Promise.resolve(bodyIndex);
    if (!bodyIndexPromise) {
      bodyIndexPromise = fetch('/search-index.json')
        .then((res) => (res.ok ? res.json() : []))
        .then((data: SearchDoc[]) => {
          bodyIndex = Array.isArray(data) ? data : [];
          return bodyIndex;
        })
        .catch(() => {
          bodyIndex = [];
          return bodyIndex;
        });
    }
    return bodyIndexPromise;
  };

  const haystackOf = (item: HTMLElement, docs: SearchDoc[] | null) => {
    const base = item.dataset.search ?? '';
    if (!docs?.length) return base;
    const url = item.dataset.url ?? item.querySelector('a')?.getAttribute('href') ?? '';
    const doc = docs.find((entry) => entry.url === url);
    if (!doc) return base;
    return `${base} ${doc.body}`.toLowerCase();
  };

  const isOwner = () => document.documentElement.getAttribute('data-owner-verified') === '1';
  const itemAllowed = (item: HTMLElement) => isOwner() || item.dataset.locked !== '1';

  const apply = async () => {
    if (!input) return;
    const term = input.value.trim().toLowerCase();
    const docs = term ? await loadIndex() : bodyIndex;
    let visible = 0;
    const catalog = items.filter(itemAllowed).length;
    for (const item of items) {
      const haystack = haystackOf(item, docs);
      const show = itemAllowed(item) && (term.length === 0 || haystack.includes(term));
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
    if (count) {
      count.textContent = term
        ? `${visible}개가 일치합니다.`
        : `${catalog}개의 글에서 제목·본문·주제·태그로 찾습니다. 본문 색인은 처음 검색할 때 불러옵니다.`;
    }
  };

  const params = new URLSearchParams(location.search);
  const initial = params.get('q');
  if (input && initial) {
    input.value = initial;
    apply();
  }

  input?.addEventListener('input', () => {
    const url = new URL(location.href);
    const term = input.value.trim();
    if (term) url.searchParams.set('q', term);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    apply();
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    apply();
  });

  document.addEventListener('blog:owner-session', () => {
    void apply();
  });
  void apply();
</script>
