---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import KubeCube from '../components/KubeCube.astro';
import OwnerActions from '../components/OwnerActions.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { absoluteUrl } from '../lib/seo';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const personId = absoluteUrl('/about/#person');
const websiteId = absoluteUrl('/#website');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.title,
      url: site.url,
      description: site.description,
      inLanguage: 'ko-KR',
      publisher: { '@id': personId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${absoluteUrl('/search/')}?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.author,
      url: absoluteUrl('/about/'),
      sameAs: ['https://github.com/qkrtjswo03'],
    },
  ],
};
---

<BaseLayout jsonLd={jsonLd} source="src/pages/index.astro">
  <section class="hero-banner" aria-label={site.title}>
    <div class="hero-stage">
      <img
        src="/images/hero/hero-banner-1600.webp"
        srcset="/images/hero/hero-banner-960.webp 960w, /images/hero/hero-banner-1600.webp 1600w, /images/hero/hero-banner-2560.webp 2560w"
        sizes="(max-width: 860px) calc(100vw - 2rem), calc(100vw - 272px - 3.2rem)"
        width="2560"
        height="1440"
        alt="클라우드와 서버, 차트가 이어진 배너 일러스트"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <KubeCube />
    </div>
    <div class="hero-shine" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-title"><span data-typewrite>{site.title}</span></h1>
      <p class="hero-sub"><span data-typewrite>{site.tagline}</span></p>
      <div class="hero-actions">
        <a href="#posts">글 보기</a>
        <a href="/projects/">프로젝트</a>
      </div>
    </div>
  </section>
  <section id="posts" class="home-main" aria-labelledby="latest-heading">
    <div class="list-head">
      <Cmd command="k9s -c posts" />
      <OwnerActions links={[{ href: '#term-new-post', label: 'new post' }]} />
    </div>
    <h2 id="latest-heading" class="sr-only">최근 글</h2>
    <PostList posts={posts} grouped />
  </section>
</BaseLayout>
