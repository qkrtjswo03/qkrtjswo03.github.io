---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import OwnerActions from '../components/OwnerActions.astro';
import PostList from '../components/PostList.astro';
import { newPostUrl } from '../lib/github';
import { site } from '../config';
import { absoluteUrl } from '../lib/seo';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  description: site.description,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: site.author },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${absoluteUrl('/search/')}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero-banner" aria-label={site.title}>
    <img
      src="/images/hero/hero-banner-1600.webp"
      srcset="/images/hero/hero-banner-960.webp 960w, /images/hero/hero-banner-1600.webp 1600w, /images/hero/hero-banner-2560.webp 2560w"
      sizes="(max-width: 860px) calc(100vw - 2rem), calc(100vw - 272px - 3.2rem)"
      width="2560"
      height="1440"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-copy">
      <h1 class="hero-title">{site.title}</h1>
      <p class="hero-sub">{site.tagline}</p>
      <div class="hero-actions">
        <a href="#posts">글 보기</a>
        <a href="/projects/">프로젝트</a>
      </div>
    </div>
  </section>
  <section id="posts" class="home-main" aria-labelledby="latest-heading">
    <div class="list-head">
      <Cmd command="kubectl get posts" />
      <OwnerActions links={[{ href: newPostUrl(), label: 'new post' }]} />
    </div>
    <h2 id="latest-heading" class="sr-only">최근 글</h2>
    <PostList posts={posts} grouped />
  </section>
</BaseLayout>
