---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import KubeCube from '../components/KubeCube.astro';
import OwnerActions from '../components/OwnerActions.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { absoluteUrl } from '../lib/seo';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  description: site.description,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: site.author },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${absoluteUrl('/search/')}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd} source="src/pages/index.astro">
  <section class="hero-banner" aria-label={site.title}>
    <div class="hero-stage">
      <img
        src="/images/hero/hero-banner-1600.webp"
        srcset="/images/hero/hero-banner-960.webp 960w, /images/hero/hero-banner-1600.webp 1600w, /images/hero/hero-banner-2560.webp 2560w"
        sizes="(max-width: 860px) calc(100vw - 2rem), calc(100vw - 272px - 3.2rem)"
        width="2560"
        height="1440"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <KubeCube />
    </div>
    <div class="hero-hotspots" aria-hidden="true">
      <button type="button" class="hero-hotspot hero-hotspot-db" data-label="Database" tabindex="-1">
        <span class="hero-ico-anchor">
          <span class="hero-ico-float">
            <span class="hero-ico-tilt">
              <span class="hero-ico-cube">
          <div class="hero-ico-face hero-ico-face-front"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-back"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-right"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-left"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-top"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-bottom"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="32" cy="18" rx="16" ry="7"/><path d="M16 18v28c0 3.9 7.2 7 16 7s16-3.1 16-7V18"/><path d="M16 32c0 3.9 7.2 7 16 7s16-3.1 16-7"/><path d="M16 46c0 3.9 7.2 7 16 7s16-3.1 16-7"/></g></svg></div>
              </span>
            </span>
          </span>
        </span>
      </button>
      <button type="button" class="hero-hotspot hero-hotspot-obj" data-label="Object Storage" tabindex="-1">
        <span class="hero-ico-anchor">
          <span class="hero-ico-float">
            <span class="hero-ico-tilt">
              <span class="hero-ico-cube">
          <div class="hero-ico-face hero-ico-face-front"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-back"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-right"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-left"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-top"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-bottom"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 26h28l-3 22H21L18 26z"/><path d="M22 26l2-8h16l2 8"/><path d="M28 34v8M36 34v8"/></g></svg></div>
              </span>
            </span>
          </span>
        </span>
      </button>
      <button type="button" class="hero-hotspot hero-hotspot-compute" data-label="Compute" tabindex="-1">
        <span class="hero-ico-anchor">
          <span class="hero-ico-float">
            <span class="hero-ico-tilt">
              <span class="hero-ico-cube">
          <div class="hero-ico-face hero-ico-face-front"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-back"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-right"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-left"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-top"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
          <div class="hero-ico-face hero-ico-face-bottom"><svg viewBox="0 0 64 64" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="32" height="32" rx="4"/><path d="M24 16v32M40 16v32M16 28h32M16 36h32"/></g></svg></div>
              </span>
            </span>
          </span>
        </span>
      </button>
    </div>
    <div class="hero-copy">
      <h1 class="hero-title">{site.title}</h1>
      <p class="hero-sub">{site.tagline}</p>
      <div class="hero-actions">
        <a href="#posts">글 보기</a>
        <a href="/projects/">프로젝트</a>
      </div>
    </div>
  </section>
  <section id="posts" class="home-main" aria-labelledby="latest-heading">
    <div class="list-head">
      <Cmd command="k9s -c posts" />
      <OwnerActions links={[{ href: '#term-new-post', label: 'new post' }]} />
    </div>
    <h2 id="latest-heading" class="sr-only">최근 글</h2>
    <PostList posts={posts} grouped />
  </section>
</BaseLayout>
