---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cmd from '../components/Cmd.astro';
import OwnerActions from '../components/OwnerActions.astro';
import PostList from '../components/PostList.astro';
import { newPostUrl } from '../lib/github';
import { site } from '../config';
import { absoluteUrl } from '../lib/seo';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  description: site.description,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: site.author },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${absoluteUrl('/search/')}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="home-main" aria-labelledby="latest-heading">
    <div class="list-head">
      <Cmd command="kubectl get posts" />
      <OwnerActions links={[{ href: newPostUrl(), label: 'new post' }]} />
    </div>
    <h2 id="latest-heading" class="sr-only">최근 글</h2>
    <PostList posts={posts} grouped />
  </section>
</BaseLayout>
