---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../../components/Cmd.astro';
import PostList from '../../components/PostList.astro';
import { countTerms, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return countTerms(posts, 'categories').map(([category]) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => (post.data.categories ?? []).includes(category)),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={category} description={`${category} 주제의 글 ${posts.length}편입니다.`} source="src/pages/categories/[category].astro">
  <header class="page-intro">
    <Cmd command={`kubectl get posts -l category=${category}`} />
    <h1>{category}</h1>
    <p>{posts.length}개의 글</p>
  </header>
  <PostList posts={posts} contextCategory={category} />
</BaseLayout>
