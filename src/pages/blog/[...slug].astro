---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, neighbors, postsInSeries, postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const locked = post.data.locked === true;
const rendered = locked ? null : await render(post);
const headings = rendered?.headings ?? [];
const Content = rendered?.Content;
const posts = await getPosts();
const { older, newer } = neighbors(posts, postSlug(post.id));
const seriesList = post.data.series ? postsInSeries(posts, post.data.series) : [];
---

<PostLayout post={post} headings={headings} older={older} newer={newer} seriesList={seriesList}>
  {Content ? <Content /> : null}
</PostLayout>
