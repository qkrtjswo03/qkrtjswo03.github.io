---
import { getPosts, postUrl } from '../lib/posts';

const repo = 'qkrtjswo03/qkrtjswo03.github.io';
const lockedHrefs = (await getPosts()).filter((post) => post.data.locked).map((post) => postUrl(post));
---

<script type="application/json" id="locked-post-hrefs" data-repo={repo} set:html={JSON.stringify(lockedHrefs)} />

<dialog class="post-lock-dialog" id="owner-lock-dialog" aria-labelledby="owner-lock-title" transition:persist="lock-dialog">
  <div class="post-lock-panel">
    <div class="post-lock-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="5" y="11" width="14" height="10" rx="2" />
        <path d="M8 11V8a4 4 0 0 1 8 0v3" />
      </svg>
    </div>
    <p class="post-lock-heading" id="owner-lock-title">잠긴 글입니다</p>
    <p>이 글은 저장소 주인만 볼 수 있습니다. 주인 GitHub 토큰으로 인증하면 엽니다.</p>
    <form class="post-lock-form" data-owner-lock-form>
      <label class="sr-only" for="owner-lock-token">GitHub 토큰</label>
      <input
        id="owner-lock-token"
        class="post-lock-input"
        type="password"
        name="token"
        autocomplete="off"
        spellcheck="false"
        placeholder="GitHub 토큰"
        required
      />
      <button type="submit" class="post-lock-btn">인증 후 열기</button>
      <button type="button" class="post-lock-btn is-ghost" data-owner-lock-close>닫기</button>
    </form>
    <p class="post-lock-error" data-owner-lock-error hidden>토큰이 올바르지 않거나 저장소 주인이 아닙니다.</p>
  </div>
</dialog>

<script>
  import {
    applyOwnerFlag,
    ensureOwner,
    fetchRepoMarkdown,
    markVerified,
    normalizeSitePath,
    readSession,
    rememberVerified,
    renderMarkdownHtml,
    saveOwnerSession,
    verifyOwnerToken,
  } from '../lib/owner-session';

  const dataNode = document.getElementById('locked-post-hrefs');
  const repo = dataNode?.dataset.repo || 'qkrtjswo03/qkrtjswo03.github.io';
  const owner = (repo.split('/')[0] || '').toLowerCase();
  const locked = new Set<string>();
  try {
    const list = JSON.parse(dataNode?.textContent || '[]') as string[];
    for (const href of list) {
      const path = normalizeSitePath(href);
      if (path) locked.add(path);
    }
  } catch {
    /* empty */
  }

  const dialog = document.getElementById('owner-lock-dialog');
  const form = dialog?.querySelector<HTMLFormElement>('[data-owner-lock-form]');
  const input = dialog?.querySelector<HTMLInputElement>('#owner-lock-token');
  const errorEl = dialog?.querySelector<HTMLElement>('[data-owner-lock-error]');
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('[data-owner-lock-close]');

  let pendingHref = '';
  let pendingMode: 'navigate' | 'here' = 'navigate';

  const showError = (message: string) => {
    if (!(errorEl instanceof HTMLElement)) return;
    errorEl.hidden = false;
    errorEl.textContent = message;
  };

  const clearError = () => {
    if (!(errorEl instanceof HTMLElement)) return;
    errorEl.hidden = true;
  };

  async function revealArticle(token: string) {
    const article = document.querySelector<HTMLElement>('[data-locked-article]');
    const prose = article?.querySelector<HTMLElement>('[data-locked-prose]');
    const pending = document.querySelector<HTMLElement>('[data-locked-pending]');
    const path = article?.dataset.path || '';
    if (!(article instanceof HTMLElement) || !(prose instanceof HTMLElement) || !path) return;
    prose.textContent = '본문을 불러오는 중…';
    article.hidden = false;
    if (pending) pending.hidden = true;
    try {
      const markdown = await fetchRepoMarkdown(token, repo, path);
      prose.innerHTML = await renderMarkdownHtml(token, repo, markdown);
    } catch (error) {
      prose.textContent = error instanceof Error ? error.message : '본문을 불러오지 못했습니다.';
    }
  }

  const shake = (el: Element | null | undefined) => {
    if (!(el instanceof HTMLElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.classList.remove('is-lock-shake');
    void el.offsetWidth;
    el.classList.add('is-lock-shake');
  };

  function openDialog(href: string, mode: 'navigate' | 'here') {
    pendingHref = href;
    pendingMode = mode;
    clearError();
    if (input) input.value = '';
    shake(dialog?.querySelector('.post-lock-icon'));
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
    input?.focus();
  }

  async function proceed(href: string, mode: 'navigate' | 'here') {
    const check = await ensureOwner(owner);
    if (check.ok && check.token) {
      const here = normalizeSitePath(location.href) === normalizeSitePath(href);
      if (mode === 'here' || here) await revealArticle(check.token);
      else location.assign(href);
      return;
    }
    openDialog(href, mode === 'here' ? 'here' : 'navigate');
  }

  function intercept(href: string, mode: 'navigate' | 'here' = 'navigate') {
    const path = normalizeSitePath(href);
    if (!path || !locked.has(path)) return false;
    void proceed(href, mode);
    return true;
  }

  window.SunjaeLock = {
    intercept,
    ensureOwner: () => ensureOwner(owner),
  };

  const onLockedClick = (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('[data-k9s-lock], [data-owner-lock-form], [data-locked-open]')) return;
    const link = target.closest('a[href]');
    if (!(link instanceof HTMLAnchorElement)) return;
    if (!locked.has(normalizeSitePath(link.href))) return;
    event.preventDefault();
    event.stopPropagation();
    shake(link.closest('tr')?.querySelector('[data-lock-status], [data-k9s-lock]'));
    intercept(link.href, 'navigate');
  };

  document.addEventListener('click', onLockedClick, true);
  document.addEventListener('auxclick', onLockedClick, true);

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('[data-locked-open]')) return;
    event.preventDefault();
    intercept(location.href, 'here');
  });

  closeBtn?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const token = input?.value.trim() ?? '';
    if (input) input.value = '';
    if (!token) {
      showError('토큰이 올바르지 않거나 저장소 주인이 아닙니다.');
      return;
    }
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    void (async () => {
      const check = await verifyOwnerToken(token, owner);
      if (!check.ok || !check.login) {
        showError(check.error || '토큰이 올바르지 않거나 저장소 주인이 아닙니다.');
        if (submit) submit.disabled = false;
        return;
      }
      saveOwnerSession(token, check.login);
      rememberVerified(token, { ...check, token });
      applyOwnerFlag(true);
      markVerified(true);
      clearError();
      const icon = dialog?.querySelector('.post-lock-icon');
      if (icon instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        icon.classList.add('is-lock-unlock');
        await new Promise((resolve) => window.setTimeout(resolve, 460));
        icon.classList.remove('is-lock-unlock');
      }
      if (dialog instanceof HTMLDialogElement) dialog.close();
      if (submit) submit.disabled = false;
      if (pendingMode === 'here' || normalizeSitePath(location.href) === normalizeSitePath(pendingHref)) {
        await revealArticle(token);
      } else if (pendingHref) {
        location.assign(pendingHref);
      }
    })();
  });

  const watchLockedPage = () => {
    const article = document.querySelector('[data-locked-article]');
    if (article instanceof HTMLElement) {
      if (article.dataset.lockWatch === '1') return;
      article.dataset.lockWatch = '1';
      void (async () => {
        const check = await ensureOwner(owner);
        if (check.ok && check.token) await revealArticle(check.token);
        else openDialog(location.href, 'here');
      })();
      return;
    }
    if (readSession().token) void ensureOwner(owner);
    else {
      applyOwnerFlag(false);
      markVerified(false);
    }
  };
  watchLockedPage();
  document.addEventListener('astro:page-load', watchLockedPage);
</script>
