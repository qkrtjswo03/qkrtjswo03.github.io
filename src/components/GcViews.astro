---
import { goatcounterCode } from '../lib/ads';
const code = goatcounterCode();
---
{code && (
  <script is:inline define:vars={{ code }}>
    (function () {
      var base = 'https://' + code + '.goatcounter.com/counter/';
      var mem = {};
      function get(path) {
        if (mem[path]) return mem[path];
        var key = 'gc:' + path, hit;
        try { hit = JSON.parse(sessionStorage.getItem(key) || 'null'); } catch (e) {}
        if (hit && Date.now() - hit.t < 300000) return (mem[path] = Promise.resolve(hit.c));
        return (mem[path] = fetch(base + encodeURIComponent(path) + '.json')
          .then(function (r) { if (r.status === 404) return '0'; if (!r.ok) throw 0; return r.json().then(function (j) { return j.count; }); })
          .then(function (c) { try { sessionStorage.setItem(key, JSON.stringify({ t: Date.now(), c: c })); } catch (e) {} return c; }));
      }
      function run() {
        document.querySelectorAll('[data-gc-path]').forEach(function (el) {
          var out = el.querySelector('[data-gc-count]') || el;
          get(el.getAttribute('data-gc-path')).then(function (c) {
            out.textContent = String(c).trim(); el.hidden = false;
          }, function () { out.textContent = '—'; });
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
    })();
  </script>
)}
