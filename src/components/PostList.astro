---
import {
  formatDate,
  groupByCategory,
  postsInSeries,
  postUrl,
  searchText,
  seriesLabel,
  seriesTitle,
  type BlogPost,
} from '../lib/posts';

interface Props {
  posts: BlogPost[];
  searchable?: boolean;
  grouped?: boolean;
  contextCategory?: string;
}

const { posts, searchable = false, grouped = false, contextCategory } = Astro.props;
const groups = grouped ? groupByCategory(posts) : [];

function categoryLabel(post: BlogPost) {
  const categories = post.data.categories ?? [];
  return categories.length > 0 ? categories.join(', ') : '—';
}

function primaryCategory(post: BlogPost) {
  if (contextCategory) return contextCategory;
  const categories = post.data.categories ?? [];
  return categories.length > 0 ? categories[0] : '';
}

const CATEGORY_HUES: Record<string, number> = {
  네트워크: 205,
  쿠버네티스: 188,
  'Kubernetes 구축': 265,
  관측: 158,
  트러블슈팅: 22,
  엣지: 338,
  보안: 285,
  클라우드: 46,
  AI: 310,
  기타: 170,
};

const FALLBACK_HUES = [205, 188, 265, 158, 22, 338, 285, 46, 170, 310];

function hueFor(category: string) {
  const fixed = CATEGORY_HUES[category];
  if (fixed !== undefined) return fixed;
  let h = 5381;
  for (let i = 0; i < category.length; i += 1) {
    h = ((h * 33) ^ category.charCodeAt(i)) >>> 0;
  }
  return FALLBACK_HUES[h % FALLBACK_HUES.length];
}
---

{
  posts.length === 0 ? (
    <p class="empty">아직 공개된 글이 없습니다.</p>
  ) : grouped ? (
    <>
      <nav class="jump-nav" aria-label="주제 바로가기">
        {groups.map((group, index) => (
          <a href={`#group-${index}`}>
            {group.category} <span class="count">{group.posts.length}</span>
          </a>
        ))}
      </nav>
      {groups.map((group, index) => {
        const seriesIds = [
          ...new Set(group.posts.map((post) => post.data.series).filter((id): id is string => Boolean(id))),
        ];
        const loose = group.posts.filter((post) => !post.data.series);
        return (
          <section class="post-group" id={`group-${index}`} aria-labelledby={`group-${index}-title`}>
            <h2 class="post-group-title" id={`group-${index}-title`}>
              {group.category} <span class="count">{group.posts.length}</span>
            </h2>
            <div class="post-body">
              {seriesIds.map((id) => {
                const parts = postsInSeries(group.posts, id);
                return (
                  <div class="series-list">
                    <p class="series-list-title">
                      {seriesTitle(id)} <span class="count">{parts.length}</span>
                    </p>
                    <ol>
                      {parts.map((post) => (
                        <li>
                          <a href={postUrl(post)}>
                            <span class="series-num">{post.data.seriesOrder}</span>
                            {seriesLabel(post)}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                );
              })}
              {loose.length > 0 && (
                <ul class="post-list post-cards">
                  {loose.map((post) => (
                    <li>
<a class="post-card" href={postUrl(post)}>
                        <span class="post-cover" style={`--h: ${hueFor(primaryCategory(post))}`} aria-hidden="true">
                          <span class="post-cover-cat">{primaryCategory(post) || 'post'}</span>
                        </span>
                        <span class="post-card-body">
                          <span class="post-title">{post.data.title}</span>
                          <span class="post-desc">{post.data.description}</span>
                          <span class="post-meta">
                            <span class="post-cat">
                              <span class="sr-only">주제 </span>
                              {categoryLabel(post)}
                            </span>
                            <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                              <span class="sr-only">날짜 </span>
                              {formatDate(post.data.pubDate)}
                            </time>
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        );
      })}
    </>
  ) : (
    <>
      <p class="sr-only">글 목록. 이름, 주제, 날짜.</p>
      <ul class="post-list post-cards" id={searchable ? 'results' : undefined}>
        {posts.map((post) => (
          <li data-search={searchable ? searchText(post) : undefined}>
<a class="post-card" href={postUrl(post)}>
              <span class="post-cover" style={`--h: ${hueFor(primaryCategory(post))}`} aria-hidden="true">
                <span class="post-cover-cat">{primaryCategory(post) || 'post'}</span>
              </span>
              <span class="post-card-body">
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
                <span class="post-meta">
                  <span class="post-cat">
                    <span class="sr-only">주제 </span>
                    {categoryLabel(post)}
                  </span>
                  <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                    <span class="sr-only">날짜 </span>
                    {formatDate(post.data.pubDate)}
                  </time>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
