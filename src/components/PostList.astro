---
import {
  formatDate,
  groupByCategory,
  postUrl,
  searchText,
  type BlogPost,
} from '../lib/posts';
import { editPostUrl, lockPostUrl } from '../lib/github';
import { goatcounterCode } from '../lib/ads';
const gc = goatcounterCode();

interface Props {
  posts: BlogPost[];
  searchable?: boolean;
  grouped?: boolean;
  contextCategory?: string;
}

const { posts, searchable = false, grouped = false, contextCategory } = Astro.props;
const groups = grouped ? groupByCategory(posts) : [];

function primaryCategory(post: BlogPost) {
  if (contextCategory) return contextCategory;
  const categories = post.data.categories ?? [];
  return categories.length > 0 ? categories[0]! : '—';
}

const sorted = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

{
  posts.length === 0 ? (
    <p class="empty">아직 공개된 글이 없습니다.</p>
  ) : (
    <div class="k9s" data-k9s>
      {grouped && groups.length > 0 && (
        <nav class="jump-nav k9s-jumps" aria-label="주제 바로가기">
          {groups.map((group, index) => (
            <a href={`#ns-${index}`}>
              {group.category} <span class="count">{group.posts.length}</span>
            </a>
          ))}
        </nav>
      )}

      <div class="k9s-frame" role="region" aria-label="글 목록" tabindex="0">
        <div class="k9s-top">
          <span class="k9s-pill">ctx sunjae-blog</span>
          <span>&lt;posts&gt;</span>
          <span data-k9s-count>{posts.length} items</span>
          <span class="k9s-keys" aria-label="단축키">
            <span><b>&lt;enter&gt;</b> open</span>
            <span><b>/</b> filter</span>
            <span><b>j/k ↑/↓</b> move</span>
            <span><b>e</b> edit</span>
            <span><b>esc</b> clear</span>
          </span>
          <span class="k9s-crumbs" data-k9s-status>Ready</span>
        </div>

        <form class="k9s-filter" data-k9s-filter hidden>
          <label class="sr-only" for={searchable ? 'k9s-filter-q' : 'k9s-filter-q-main'}>필터</label>
          <span aria-hidden="true">/</span>
          <input
            id={searchable ? 'k9s-filter-q' : 'k9s-filter-q-main'}
            type="search"
            name="k9s-q"
            placeholder="제목 · 주제 · 태그"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" data-k9s-filter-close class="k9s-filter-close">esc</button>
        </form>

        <p class="sr-only">글 목록. 주제, 이름, 상태, 날짜. / 로 필터, Enter 로 열기, j/k 또는 화살표로 이동, e 로 편집. 자물쇠는 잠금 상태이며, 전환은 저장소 주인만 할 수 있습니다.</p>
        <div class="k9s-table-wrap">
          <table class="k9s-table">
            <thead>
              <tr>
                <th scope="col">NAMESPACE</th>
                <th scope="col">NAME</th>
                <th scope="col">READY</th>
                <th scope="col">STATUS</th>
                <th scope="col">AGE</th>
              </tr>
            </thead>
            <tbody id={searchable ? 'results' : undefined} data-k9s-body>
              {sorted.map((post, index) => {
                const ns = primaryCategory(post);
                const groupIndex = grouped ? groups.findIndex((g) => g.category === ns) : -1;
                const firstOfNs =
                  groupIndex >= 0 && sorted.findIndex((p) => primaryCategory(p) === ns) === index;
                return (
                  <tr
                    class:list={['k9s-row', index === 0 && 'is-active']}
                    id={firstOfNs ? `ns-${groupIndex}` : undefined}
                    data-search={searchText(post)}
                    data-title={post.data.title}
                    data-desc={post.data.locked ? '잠긴 글입니다. 본문은 공개하지 않습니다.' : post.data.description}
                    data-ns={ns}
                    data-age={formatDate(post.data.pubDate)}
                    data-edit={editPostUrl(post)}
                    data-lock={lockPostUrl(post)}
                    data-locked={post.data.locked ? '1' : '0'}
                  >
                    <td class="k9s-ns">{ns}</td>
                    <td class="k9s-name">
                      <a href={postUrl(post)}>{post.data.title}</a>
                      <span
                        class:list={['k9s-lock-status', post.data.locked && 'is-locked']}
                        data-lock-status
                        title={post.data.locked ? '잠긴 글' : '공개된 글'}
                        aria-label={post.data.locked ? '잠긴 글' : '공개된 글'}
                      >
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.1">
                          <rect x="5" y="11" width="14" height="10" rx="2" />
                          <path d={post.data.locked ? 'M8 11V8a4 4 0 0 1 8 0v3' : 'M8 11V8a4 4 0 0 1 8 0'} />
                        </svg>
                      </span>
                      <button
                        type="button"
                        class:list={['k9s-lock-btn', post.data.locked && 'is-locked']}
                        data-k9s-lock
                        title={post.data.locked ? '잠금 해제' : '잠금'}
                        aria-label={post.data.locked ? '잠금 해제' : '잠금'}
                        aria-pressed={post.data.locked ? 'true' : 'false'}
                      >
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.1">
                          <rect x="5" y="11" width="14" height="10" rx="2" />
                          <path d={post.data.locked ? 'M8 11V8a4 4 0 0 1 8 0v3' : 'M8 11V8a4 4 0 0 1 8 0'} />
                        </svg>
                      </button>
                      {gc && <span class="k9s-views" data-gc-path={postUrl(post)} hidden title="조회수"> · <span data-gc-count>—</span></span>}
                    </td>
                    <td class="k9s-ready">1/1</td>
                    <td class:list={['k9s-status', post.data.locked && 'is-pending']}>
                      {post.data.locked ? 'Pending' : 'Published'}
                    </td>
                    <td class="k9s-age">
                      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <aside class="k9s-preview" data-k9s-preview hidden>
          <p class="k9s-preview-ns" data-k9s-preview-ns></p>
          <p class="k9s-preview-title" data-k9s-preview-title></p>
          <p class="k9s-preview-desc" data-k9s-preview-desc></p>
          <p class="k9s-preview-age" data-k9s-preview-age></p>
        </aside>

      </div>
    </div>
  )
}

<style>
  .k9s-views { font-size: 0.75em; opacity: 0.6; font-variant-numeric: tabular-nums; }
  .k9s-lock-status,
  .k9s-lock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.4rem;
    padding: 0.2rem;
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--ink-soft, #8b9bb4) 70%, #667);
    opacity: 0.55;
    filter: brightness(0.9);
    vertical-align: middle;
    min-width: 1.5rem;
    min-height: 1.5rem;
  }
  .k9s-lock-status {
    cursor: default;
    pointer-events: none;
  }
  .k9s-lock-btn {
    display: none;
    cursor: pointer;
  }
  :global(html[data-owner-verified='1']) .k9s-lock-btn {
    display: inline-flex;
  }
  :global(html[data-owner-verified='1']) .k9s-lock-status {
    display: none;
  }
  .k9s-lock-status svg,
  .k9s-lock-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .k9s-lock-btn:hover { opacity: 0.85; filter: brightness(1); }
  .k9s-lock-btn.is-locked,
  .k9s-lock-status.is-locked {
    color: var(--cyan, #22d3ee);
    opacity: 1;
    filter: brightness(1.35) drop-shadow(0 0 6px color-mix(in srgb, var(--cyan, #22d3ee) 55%, transparent));
  }
  .k9s-lock-btn.is-locked:hover { filter: brightness(1.5) drop-shadow(0 0 8px color-mix(in srgb, var(--cyan, #22d3ee) 65%, transparent)); }
  .k9s-status.is-pending {
    color: var(--warn, #f59e0b);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>

<script>
  const mountK9s = () => {
  const roots = document.querySelectorAll<HTMLElement>('[data-k9s]');

  roots.forEach((root) => {
    if (root.dataset.k9sBound === '1') return;
    root.dataset.k9sBound = '1';
    const frame = root.querySelector<HTMLElement>('.k9s-frame');
    const body = root.querySelector<HTMLElement>('[data-k9s-body]');
    const filter = root.querySelector<HTMLElement>('[data-k9s-filter]');
    const input = root.querySelector<HTMLInputElement>('[data-k9s-filter] input');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-k9s-filter-close]');
    const countEl = root.querySelector<HTMLElement>('[data-k9s-count]');
    const statusEl = root.querySelector<HTMLElement>('[data-k9s-status]');
    if (!frame || !body || !filter || !input) return;

    const rows = () => [...body.querySelectorAll<HTMLTableRowElement>('tr.k9s-row')];
    const visibleRows = () => rows().filter((row) => !row.hidden);

    const preview = root.querySelector<HTMLElement>('[data-k9s-preview]');
    const previewNs = root.querySelector<HTMLElement>('[data-k9s-preview-ns]');
    const previewTitle = root.querySelector<HTMLElement>('[data-k9s-preview-title]');
    const previewDesc = root.querySelector<HTMLElement>('[data-k9s-preview-desc]');
    const previewAge = root.querySelector<HTMLElement>('[data-k9s-preview-age]');

    const showPreview = (row: HTMLTableRowElement | undefined) => {
      if (!preview || !previewTitle || !previewDesc || !previewNs || !previewAge) return;
      if (!row || row.hidden) {
        preview.hidden = true;
        return;
      }
      previewNs.textContent = row.dataset.ns ?? '';
      previewTitle.textContent = row.dataset.title ?? '';
      previewDesc.textContent = row.dataset.desc ?? '';
      previewAge.textContent = row.dataset.age ? `AGE ${row.dataset.age}` : '';
      preview.hidden = false;
    };

    const setActive = (row: HTMLTableRowElement | undefined, reveal = true) => {
      rows().forEach((r) => r.classList.remove('is-active'));
      if (!row) {
        showPreview(undefined);
        return;
      }
      row.classList.add('is-active');
      if (reveal) {
        row.scrollIntoView({ block: 'nearest' });
        showPreview(row);
      }
    };

    const activeRow = () => visibleRows().find((row) => row.classList.contains('is-active')) ?? visibleRows()[0];

    const applyFilter = () => {
      const term = input.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows()) {
        const hay = row.dataset.search ?? '';
        const show = term.length === 0 || hay.includes(term);
        row.hidden = !show;
        if (show) visible += 1;
      }
      if (countEl) {
        countEl.textContent = term ? `${visible}/${rows().length} items` : `${rows().length} items`;
      }
      if (statusEl) {
        statusEl.textContent = term ? (visible ? `filter "${term}"` : 'no match') : 'Ready';
      }
      const current = activeRow();
      setActive(current, !preview?.hidden);
    };

    const openFilter = () => {
      filter.hidden = false;
      input.focus();
      input.select();
    };

    const closeFilter = (clear = false) => {
      if (clear) {
        input.value = '';
        applyFilter();
      }
      filter.hidden = true;
      frame.focus();
    };

    const openActive = () => {
      const row = activeRow();
      const link = row?.querySelector<HTMLAnchorElement>('a');
      if (!link) return;
      if (row?.dataset.locked === '1') {
        if (window.SunjaeLock?.intercept(link.href)) return;
        window.alert('잠긴 글입니다. 저장소 주인만 열 수 있습니다.');
        return;
      }
      window.location.href = link.href;
    };

    const editActive = () => {
      const row = activeRow();
      const href = row?.dataset.edit;
      if (!href) return;
      if (!sessionStorage.getItem('blog-terminal-token')) {
        if (statusEl) statusEl.textContent = 'e edit: 먼저 터미널에서 login 하세요';
      }
      const a = document.createElement('a');
      a.href = href;
      a.hidden = true;
      document.body.appendChild(a);
      a.click();
      a.remove();
    };

    const LOCKED_PATH = 'M8 11V8a4 4 0 0 1 8 0v3';
    const OPEN_PATH = 'M8 11V8a4 4 0 0 1 8 0';

    const paintLockIcon = (el: Element | null, locked: boolean) => {
      if (!el) return;
      el.classList.toggle('is-locked', locked);
      const pathEl = el.querySelector('path');
      if (pathEl) pathEl.setAttribute('d', locked ? LOCKED_PATH : OPEN_PATH);
      if (el instanceof HTMLButtonElement) {
        el.title = locked ? '잠금 해제' : '잠금';
        el.setAttribute('aria-label', locked ? '잠금 해제' : '잠금');
        el.setAttribute('aria-pressed', locked ? 'true' : 'false');
      } else if (el instanceof HTMLElement) {
        const label = locked ? '잠긴 글' : '공개된 글';
        el.title = label;
        el.setAttribute('aria-label', label);
      }
    };

    const applyLockUi = (row: HTMLTableRowElement, locked: boolean) => {
      row.dataset.locked = locked ? '1' : '0';
      paintLockIcon(row.querySelector('[data-k9s-lock]'), locked);
      paintLockIcon(row.querySelector('[data-lock-status]'), locked);
      const status = row.querySelector('.k9s-status');
      if (status) {
        status.classList.toggle('is-pending', locked);
        status.textContent = locked ? 'Pending' : 'Published';
      }
    };

    const toggleLock = async (row: HTMLTableRowElement | undefined) => {
      const href = row?.dataset.lock;
      if (!href || !row) return;
      const check = await window.SunjaeLock?.ensureOwner();
      if (!check?.ok) {
        if (statusEl) statusEl.textContent = 'lock: 저장소 주인만 잠그거나 풀 수 있습니다.';
        return;
      }
      if (statusEl) statusEl.textContent = 'lock: main 반영 중…';
      const a = document.createElement('a');
      a.href = href;
      a.hidden = true;
      document.body.appendChild(a);
      a.click();
      a.remove();
    };

    document.addEventListener('blog:post-lock', ((event: CustomEvent<{ path?: string; locked?: boolean; ok?: boolean }>) => {
      const detail = event.detail;
      if (!detail?.path) return;
      const encoded = encodeURIComponent(detail.path);
      const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('tr.k9s-row'));
      const row = rows.find((r) => {
        const href = r.dataset.lock || '';
        return href.endsWith(encoded) || href.includes(encoded) || href.includes(detail.path!);
      });
      if (!row) return;
      if (detail.ok === false) {
        if (statusEl) statusEl.textContent = 'lock: 실패 · 주인 인증 또는 터미널 로그를 확인하세요';
        return;
      }
      if (typeof detail.locked === 'boolean') applyLockUi(row, detail.locked);
      if (statusEl) statusEl.textContent = detail.locked ? 'lock: Pending · main 반영됨' : 'lock: Published · main 반영됨';
    }) as EventListener);

    body.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest('[data-k9s-lock]');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();
      const row = btn.closest('tr.k9s-row');
      if (row instanceof HTMLTableRowElement) void toggleLock(row);
    });

    const move = (delta: number) => {
      const list = visibleRows();
      if (!list.length) return;
      const current = activeRow();
      const idx = Math.max(0, list.indexOf(current!));
      const next = list[Math.min(list.length - 1, Math.max(0, idx + delta))];
      setActive(next);
    };

    closeBtn?.addEventListener('click', () => closeFilter(true));
    input.addEventListener('input', applyFilter);
    filter.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilter();
      closeFilter(false);
    });

    frame.addEventListener('keydown', (event) => {
      const target = event.target;
      const typing =
        target instanceof HTMLElement &&
        (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);

      if (typing && target === input) {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeFilter(true);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          applyFilter();
          closeFilter(false);
        } else if (event.key === 'ArrowDown') {
          event.preventDefault();
          move(1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          move(-1);
        }
        return;
      }

      if (typing) return;

      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        openFilter();
        return;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        openActive();
        return;
      }
      if (event.key === 'j' || event.key === 'ArrowDown') {
        event.preventDefault();
        move(1);
        return;
      }
      if (event.key === 'k' || event.key === 'ArrowUp') {
        event.preventDefault();
        move(-1);
        return;
      }
      if (event.key === 'e' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        editActive();
        return;
      }
      if (event.key === 'Escape') {
        closeFilter(true);
      }
    });

    // Global / when focus is on body near the list (not in terminal/input)
    document.addEventListener('keydown', (event) => {
      if (!root.isConnected || event.defaultPrevented) return;
      const target = event.target;
      if (
        target instanceof HTMLElement &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable ||
          target.closest('.term-shell'))
      ) {
        return;
      }
      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        if (!root.querySelector('.k9s-frame')) return;
        event.preventDefault();
        frame.focus();
        openFilter();
        return;
      }
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (!root.querySelector('.k9s-frame') || !visibleRows().length) return;
      if (event.key === 'ArrowDown' || event.key === 'j') {
        event.preventDefault();
        move(1);
      } else if (event.key === 'ArrowUp' || event.key === 'k') {
        event.preventDefault();
        move(-1);
      } else if (event.key === 'e') {
        event.preventDefault();
        editActive();
      }
    });

    rows().forEach((row) => {
      row.addEventListener('mouseenter', () => setActive(row));
    });

    // Hide preview once the pointer leaves the table (and the preview panel).
    const hideOnLeave = (event: MouseEvent) => {
      const to = event.relatedTarget as Node | null;
      if (to && (body.contains(to) || preview?.contains(to))) return;
      showPreview(undefined);
    };
    body.addEventListener('mouseleave', hideOnLeave);
    preview?.addEventListener('mouseleave', hideOnLeave);
    frame.addEventListener('focusout', (event) => {
      const to = event.relatedTarget as Node | null;
      if (!to || !frame.contains(to)) showPreview(undefined);
    });

    setActive(activeRow(), false);
  });
  };
  mountK9s();
  document.addEventListener('astro:page-load', mountK9s);
</script>
