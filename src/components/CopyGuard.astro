---
/** 글 본문 복사 방지. 주인 인증(data는 ensureOwner 성공 뒤에만) 되면 해제됩니다. */
---

<p class="copy-toast" data-copy-toast role="status" aria-live="polite" hidden>복사가 허용되지 않은 글입니다.</p>

<style is:global>
  [data-copy-guard] {
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }

  html.copy-allowed [data-copy-guard] {
    -webkit-user-select: text;
    user-select: text;
    -webkit-user-drag: auto;
    -webkit-touch-callout: default;
  }

  [data-copy-guard] input,
  [data-copy-guard] textarea,
  [data-copy-guard] select,
  [data-copy-guard] [contenteditable='true'] {
    -webkit-user-select: text;
    user-select: text;
    -webkit-user-drag: auto;
    -webkit-touch-callout: default;
  }

  html:not(.copy-allowed) [data-copy-guard] .copy-button,
  html:not(.copy-allowed) [data-copy-guard] button[data-copy],
  html:not(.copy-allowed) [data-copy-guard] button[aria-label='copy' i],
  html:not(.copy-allowed) [data-copy-guard] button[aria-label='Copy'],
  html:not(.copy-allowed) [data-copy-guard] button[aria-label='복사'],
  html:not(.copy-allowed) [data-copy-guard] button[title='copy' i],
  html:not(.copy-allowed) [data-copy-guard] button[title='Copy'],
  html:not(.copy-allowed) [data-copy-guard] button[title='복사'] {
    display: none !important;
  }

  [data-copy-guard] .ad-slot,
  [data-copy-guard] .ad-slot * {
    -webkit-user-select: auto;
    user-select: auto;
    -webkit-user-drag: auto;
    -webkit-touch-callout: default;
  }

  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: 3.6rem;
    z-index: 80;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.5rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--cyan) 40%, var(--line));
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-elev) 94%, transparent);
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.4;
    box-shadow: 0 10px 28px rgba(5, 11, 31, 0.45);
    pointer-events: none;
  }

  .copy-toast[hidden] {
    display: none !important;
  }
</style>

<script>
  import { ensureOwner } from '../lib/owner-session';

  const ownerOf = () => {
    const repoNode = document.getElementById('locked-post-hrefs');
    return (repoNode?.dataset.repo || 'qkrtjswo03/qkrtjswo03.github.io').split('/')[0]?.toLowerCase() || '';
  };
  const currentGuard = () => document.querySelector<HTMLElement>('[data-copy-guard]');
  let allowCopy = false;
  let toastTimer = 0;

  const showToast = () => {
    const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
    if (!(toast instanceof HTMLElement)) return;
    if (toast.parentElement !== document.body) document.body.appendChild(toast);
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, 3200);
  };

    const setAllowed = (on: boolean) => {
      allowCopy = on;
      document.documentElement.classList.toggle('copy-allowed', on);
      syncCopyButtons();
    };

    const labelOf = (el: Element) =>
      `${el.getAttribute('aria-label') || ''} ${el.getAttribute('title') || ''} ${(el.textContent || '').trim()}`.toLowerCase();

    const syncCopyButtons = () => {
      const guard = currentGuard();
      if (!guard) return;
      guard.querySelectorAll('button, [role="button"]').forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const label = labelOf(el);
        const text = (el.textContent || '').trim();
        const looksLikeCopy =
          el.hasAttribute('data-copy') ||
          el.classList.contains('copy-button') ||
          ((/copy|복사|clipboard/.test(label) && text.length <= 24) ||
            /^(copy|copied|복사|복사됨)$/.test(text.toLowerCase()));
        if (!looksLikeCopy) return;
        el.hidden = !allowCopy;
      });
    };

    const isAd = (target: EventTarget | null) =>
      target instanceof Element && Boolean(target.closest('.ad-slot, ins.adsbygoogle'));

    const isEditable = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return false;
      if (isAd(target)) return true;
      const field = target.closest('input, textarea, select, [contenteditable="true"]');
      if (field) return true;
      return Boolean(target.closest('.term-shell, .post-lock-dialog, .search-form, [data-owner-lock-form]'));
    };

    const insideGuard = (node: Node | null) => {
      const el = node instanceof Element ? node : node?.parentElement;
      return Boolean(el?.closest('[data-copy-guard]'));
    };

    const selectionHitsGuard = () => {
      const sel = document.getSelection();
      if (!sel || sel.rangeCount === 0 || sel.isCollapsed) return false;
      for (let i = 0; i < sel.rangeCount; i += 1) {
        const range = sel.getRangeAt(i);
        if (insideGuard(range.startContainer) || insideGuard(range.endContainer) || insideGuard(range.commonAncestorContainer)) {
          return true;
        }
      }
      return false;
    };

    const block = (event: Event) => {
      event.preventDefault();
      event.stopPropagation();
      showToast();
    };

    const inCurrentGuard = (event: Event) => insideGuard(event.target instanceof Node ? event.target : null);

    document.addEventListener('selectstart', (event) => {
      if (allowCopy || isEditable(event.target) || !inCurrentGuard(event)) return;
      event.preventDefault();
    }, true);

    document.addEventListener('contextmenu', (event) => {
      if (allowCopy || isEditable(event.target) || !inCurrentGuard(event)) return;
      block(event);
    }, true);

    document.addEventListener('dragstart', (event) => {
      if (allowCopy || isEditable(event.target) || !inCurrentGuard(event)) return;
      block(event);
    }, true);

    document.addEventListener(
      'copy',
      (event) => {
        if (allowCopy || isEditable(event.target)) return;
        if (!selectionHitsGuard() && !insideGuard(event.target instanceof Node ? event.target : null)) return;
        block(event);
      },
      true,
    );

    document.addEventListener(
      'cut',
      (event) => {
        if (allowCopy || isEditable(event.target)) return;
        if (!selectionHitsGuard() && !insideGuard(event.target instanceof Node ? event.target : null)) return;
        block(event);
      },
      true,
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (allowCopy || isEditable(event.target)) return;
        if (!(event.ctrlKey || event.metaKey) || event.altKey) return;
        const code = event.code;
        const inPost = insideGuard(event.target instanceof Node ? event.target : null) || selectionHitsGuard();
        if (code === 'KeyP') return;
        if ((code === 'KeyC' || code === 'KeyX' || code === 'KeyA' || code === 'KeyS' || code === 'KeyU') && inPost) {
          block(event);
        }
      },
      true,
    );

    document.addEventListener('blog:owner-session', ((event: CustomEvent<{ ok?: boolean }>) => {
      setAllowed(Boolean(event.detail?.ok));
    }) as EventListener);

    const refreshCopy = () => {
      if (!currentGuard()) {
        document.documentElement.classList.remove('copy-allowed');
        return;
      }
      void ensureOwner(ownerOf()).then((check) => setAllowed(check.ok));
    };
    refreshCopy();
    document.addEventListener('astro:page-load', refreshCopy);
</script>
