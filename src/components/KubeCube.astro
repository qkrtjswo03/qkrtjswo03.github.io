---
const faces = ['front', 'back', 'right', 'left', 'top', 'bottom'] as const;

const spokes = Array.from({ length: 7 }, (_, index) => {
  const angle = -Math.PI / 2 + (index * 2 * Math.PI) / 7;
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  const px = -sin;
  const py = cos;
  const at = (radius: number, along = 0) =>
    `${(32 + cos * radius + px * along).toFixed(2)},${(32 + sin * radius + py * along).toFixed(2)}`;
  return {
    spoke: `${at(4.8)} ${at(21.4)}`,
    grip: `${at(22.6, 4.5)} ${at(22.6, -4.5)}`,
  };
});
---

<div class="kube-shadow" aria-hidden="true"></div>
<div class="kube-anchor" aria-hidden="true">
  <div class="kube-float">
    <div class="kube-spin">
      <div class="kube-cube">
        {
          faces.map((face) => (
            <div class={`kube-face kube-face-${face}`}>
              <svg viewBox="0 0 64 64" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="32" cy="32" r="15.6" />
                  <circle cx="32" cy="32" r="3.4" />
                  {spokes.map((spoke) => (
                    <g>
                      <polyline points={spoke.spoke} />
                      <polyline points={spoke.grip} />
                    </g>
                  ))}
                </g>
              </svg>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
<script>
  const nodes = document.querySelectorAll<HTMLElement>('.kube-spin, .kube-float');
  document.addEventListener('visibilitychange', () => {
    const state = document.hidden ? 'paused' : 'running';
    nodes.forEach((node) => {
      node.style.animationPlayState = state;
    });
  });
</script>
