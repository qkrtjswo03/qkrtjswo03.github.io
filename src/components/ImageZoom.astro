---
/** 글 본문·히어로 이미지 클릭 확대 / 다시 클릭 축소 */
---

<dialog class="img-zoom" id="img-zoom" aria-label="이미지 확대">
  <img alt="" />
</dialog>

<style is:global>
  .prose img,
  .hero img {
    cursor: zoom-in;
  }

  .img-zoom {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    background: rgba(4, 10, 18, 0.88);
    color: inherit;
  }

  .img-zoom::backdrop {
    background: transparent;
  }

  .img-zoom[open] {
    display: grid;
    place-items: center;
    cursor: zoom-out;
  }

  .img-zoom img {
    display: block;
    max-width: min(96vw, 1400px);
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid var(--line, #334);
    background: var(--bg-muted, #0b1520);
    cursor: zoom-out;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45);
  }
</style>

<script>
  const dialog = document.getElementById('img-zoom');
  if (dialog instanceof HTMLDialogElement) {
    const preview = dialog.querySelector('img');
    if (preview instanceof HTMLImageElement) {
      const closeZoom = () => {
        if (dialog.open) dialog.close();
      };

      const openZoom = (src: string, alt: string) => {
        preview.src = src;
        preview.alt = alt || '';
        if (!dialog.open) dialog.showModal();
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (dialog.open) {
          event.preventDefault();
          closeZoom();
          return;
        }

        const img = target.closest('.prose img, .hero img');
        if (!(img instanceof HTMLImageElement)) return;
        if (!img.src) return;

        event.preventDefault();
        event.stopPropagation();
        openZoom(img.currentSrc || img.src, img.alt);
      });

      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeZoom();
      });
    }
  }
</script>
