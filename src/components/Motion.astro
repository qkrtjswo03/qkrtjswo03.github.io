<div class="boot" id="boot" hidden>
  <p class="boot-line" data-boot-line hidden>sunjae@k8s:~$ boot</p>
  <p class="boot-line" data-boot-line hidden>sync posts</p>
  <p class="boot-line" data-boot-line hidden>mount k9s</p>
  <p class="boot-line boot-line is-ready" data-boot-line hidden>Ready</p>
</div>
<canvas class="matrix-rain" id="matrix-rain" aria-hidden="true"></canvas>
<button type="button" class="to-top" id="to-top" hidden aria-label="맨 위로">↑</button>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const BOOT_KEY = 'sunjae-boot-seen';

  const bootDone = () => {
    document.documentElement.classList.remove('is-booting');
    document.dispatchEvent(new CustomEvent('sunjae:boot-done'));
  };

  const playBoot = () => {
    const boot = document.getElementById('boot');
    if (!(boot instanceof HTMLElement)) {
      bootDone();
      return;
    }
    let seen = false;
    try { seen = sessionStorage.getItem(BOOT_KEY) === '1'; } catch { /* ignore */ }
    if (reduce || seen) {
      boot.hidden = true;
      bootDone();
      return;
    }
    try { sessionStorage.setItem(BOOT_KEY, '1'); } catch { /* ignore */ }
    document.documentElement.classList.add('is-booting');
    boot.hidden = false;
    const lines = [...boot.querySelectorAll<HTMLElement>('[data-boot-line]')];
    const timers: number[] = [];
    lines.forEach((line, index) => {
      timers.push(window.setTimeout(() => { line.hidden = false; }, 180 + index * 280));
    });
    let closed = false;
    const close = () => {
      if (closed) return;
      closed = true;
      timers.forEach((id) => window.clearTimeout(id));
      boot.hidden = true;
      bootDone();
      document.removeEventListener('keydown', onKey);
    };
    const onKey = () => close();
    boot.addEventListener('click', close);
    document.addEventListener('keydown', onKey);
    timers.push(window.setTimeout(close, 1500));
  };

  const typewrite = (el: HTMLElement) => {
    if (el.dataset.typed === '1') return;
    el.dataset.typed = '1';
    const text = el.textContent ?? '';
    if (reduce || !document.documentElement.classList.contains('motion')) {
      el.classList.add('is-typed');
      return;
    }
    el.classList.add('is-typing');
    const live = document.createElement('span');
    live.className = 'type-live';
    live.setAttribute('aria-hidden', 'true');
    const caret = document.createElement('span');
    caret.className = 'type-caret';
    caret.setAttribute('aria-hidden', 'true');
    el.append(live, caret);
    let i = 0;
    const step = () => {
      i += 1;
      live.textContent = text.slice(0, i);
      if (i < text.length) window.setTimeout(step, 42);
      else {
        caret.remove();
        el.classList.add('is-typed');
      }
    };
    window.setTimeout(step, 80);
  };

  const enterLists = () => {
    document.querySelectorAll<HTMLElement>('.k9s-row').forEach((row, index) => {
      if (row.dataset.entered === '1') return;
      row.dataset.entered = '1';
      if (reduce || !document.documentElement.classList.contains('motion')) return;
      row.classList.add('enter');
      row.style.setProperty('--d', `${Math.min(index, 12) * 36}ms`);
      requestAnimationFrame(() => row.classList.add('is-in'));
    });
  };

  let revealObserver: IntersectionObserver | null = null;
  const reveal = () => {
    revealObserver?.disconnect();
    const nodes = document.querySelectorAll<HTMLElement>('.prose p, .prose li, .prose img, .prose figure, .prose pre, .prose h2, .prose h3');
    if (reduce || !document.documentElement.classList.contains('motion') || !('IntersectionObserver' in window)) {
      nodes.forEach((node) => node.classList.add('reveal', 'is-in'));
      return;
    }
    revealObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        revealObserver?.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    nodes.forEach((node) => {
      node.classList.add('reveal');
      const rect = node.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) node.classList.add('is-in');
      else revealObserver?.observe(node);
    });
  };

  const typeTargets = () => {
    document.querySelectorAll<HTMLElement>('[data-typewrite]').forEach((el) => typewrite(el));
  };

  const afterBoot = () => {
    enterLists();
    typeTargets();
    reveal();
  };

  let bootStarted = false;
  let booted = false;
  const onPage = () => {
    if (!bootStarted) {
      bootStarted = true;
      document.addEventListener('sunjae:boot-done', () => {
        booted = true;
        afterBoot();
      }, { once: true });
      playBoot();
    } else if (booted) {
      afterBoot();
    }
    const top = document.getElementById('to-top');
    if (top instanceof HTMLButtonElement) top.hidden = window.scrollY < 480;
  };

  const syncTop = () => {
    const top = document.getElementById('to-top');
    if (top instanceof HTMLButtonElement) top.hidden = window.scrollY < 480;
  };
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('#to-top')) return;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
  window.addEventListener('scroll', syncTop, { passive: true });

  document.addEventListener('visibilitychange', () => {
    document.documentElement.classList.toggle('is-paused', document.hidden);
  });

  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const rain = document.getElementById('matrix-rain');
  if (rain instanceof HTMLCanvasElement && !reduce && !saveData) {
    const ctx = rain.getContext('2d');
    if (ctx) {
      const glyphs = '01アイウエオカキクケコ<>/';
      let drops: number[] = [];
      const fit = () => {
        rain.width = document.documentElement.clientWidth;
        rain.height = window.innerHeight;
        const cols = Math.ceil(rain.width / 18);
        drops = Array.from({ length: Math.min(cols, 48) }, () => Math.random() * -20);
      };
      fit();
      window.addEventListener('resize', fit);
      let last = 0;
      const draw = (now: number) => {
        requestAnimationFrame(draw);
        if (document.hidden || now - last < 90) return;
        last = now;
        ctx.clearRect(0, 0, rain.width, rain.height);
        ctx.fillStyle = 'rgba(34, 211, 238, 0.55)';
        ctx.font = '12px ui-monospace, monospace';
        drops.forEach((y, i) => {
          const ch = glyphs[Math.floor(Math.random() * glyphs.length)] ?? '0';
          ctx.fillText(ch, i * 18, y * 16);
          drops[i] = y > rain.height / 16 && Math.random() > 0.975 ? 0 : y + 1;
        });
      };
      requestAnimationFrame(draw);
    }
  }

  document.addEventListener('astro:page-load', onPage);
  onPage();
</script>
