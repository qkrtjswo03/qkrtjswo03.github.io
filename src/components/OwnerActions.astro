---
interface Link {
  href: string;
  label: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<div class="owner-actions">
  {
    links.map((link) => {
      const local = link.href.startsWith('#');
      return (
        <a
          href={link.href}
          target={local ? undefined : '_blank'}
          rel={local ? undefined : 'noopener noreferrer'}
        >
          {link.label}
        </a>
      );
    })
  }
</div>
