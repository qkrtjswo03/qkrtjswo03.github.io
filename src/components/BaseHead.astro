---
import { site } from '../config';
import { adsensePublisherId, gaMeasurementId, goatcounterCode, siteVerification } from '../lib/ads';
import { absoluteUrl, DEFAULT_OG_IMAGE, OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: unknown;
}

const {
  title,
  description,
  ogType = 'website',
  image = DEFAULT_OG_IMAGE,
  imageAlt = title,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = absoluteUrl(image);
const adsense = adsensePublisherId();
const ga = gaMeasurementId();
const goatcounter = goatcounterCode();
const google = siteVerification(site.googleSiteVerification);
const naver = siteVerification(site.naverSiteVerification);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#050b1f" />
<script is:inline>
  (function () {
    try {
      // owner UI only after terminal login as repo owner (set by Terminal)
      if (localStorage.getItem('owner-mode') === '1') {
        document.documentElement.setAttribute('data-owner', '1');
      } else {
        document.documentElement.removeAttribute('data-owner');
      }
    } catch (e) {}
    try {
      localStorage.removeItem('theme');
      document.documentElement.setAttribute('data-theme', 'dark');
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', '#050b1f');
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<meta name="copyright" content={`© ${new Date().getFullYear()} ${site.author}. All Rights Reserved.`} />
<meta name="license" content="All Rights Reserved" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/pretendard/PretendardVariable.subset.90.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/pretendard/PretendardVariable.subset.91.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/jetbrains/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/jetbrains/jetbrains-mono-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={absoluteUrl('/rss.xml')} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
{google && <meta name="google-site-verification" content={google} />}
{naver && <meta name="naver-site-verification" content={naver} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{publishedTime && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />}
{publishedTime && <meta property="article:author" content={site.author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
{adsense && (
  <script
    is:inline
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
    crossorigin="anonymous"
  />
)}
{goatcounter && (
  <script
    is:inline
    async
    data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
    src="https://gc.zgo.at/count.js"
  />
)}
{ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />}
{ga && (
  <script is:inline define:vars={{ measurementId: ga }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', measurementId);
  </script>
)}
{json && <script type="application/ld+json" set:html={json} />}
