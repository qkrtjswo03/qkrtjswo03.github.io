---
import { careerProjects } from '../data/projects';
import { countTerms, formatDateISO, type BlogPost } from '../lib/posts';
import { goatcounterCode } from '../lib/ads';
const gc = goatcounterCode();

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const topics = countTerms(posts, 'categories');
const dated = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latest = dated.find((post) => !post.data.locked) ?? dated[0];
const spotlight = careerProjects.slice(0, 3);
const certifications = [
  { name: 'CKAD', image: '/certs/ckad.png' },
  { name: 'CKA', image: '/certs/cka.png' },
  { name: 'NCP', image: '/certs/ncp.png' },
  { name: 'NCA', image: '/certs/nca.png' },
];
---

<aside class="status-rail" aria-label="클러스터 상태">
  <div class="status-block">
    <div class="status-head">
      <span class="k9s-pill">ctx sunjae-blog</span>
      <span class="status-ready"><span class="status-dot" aria-hidden="true"></span>Ready</span>
    </div>
    <dl class="status-metrics">
      <div>
        <dt>POSTS</dt>
        <dd>{posts.length}</dd>
      </div>
      <div>
        <dt>NS</dt>
        <dd>{topics.length}</dd>
      </div>
      <div>
        <dt>LATEST</dt>
        <dd>{latest ? formatDateISO(latest.data.pubDate) : '—'}</dd>
      </div>
      {gc && (
        <div data-gc-path="TOTAL" hidden title="사이트 전체 방문(GoatCounter)">
          <dt>VIEWS</dt>
          <dd data-gc-count>—</dd>
        </div>
      )}
      <div title="서울 현재 시각 (KST)">
        <dt>KST</dt>
        <dd data-kst-clock>--:--:--</dd>
      </div>
    </dl>
    <p class="status-live" aria-hidden="true">
      <span>CPU <b data-live-cpu>12%</b></span>
      <span>PODS <b data-live-pods>{posts.length}</b></span>
    </p>
    <ul class="status-ns">
      {
        topics.map(([topic, count]) => (
          <li>
            <span class="ns-name">{topic}</span>
            <span class="ns-count">{count}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="status-block">
    <p class="status-label">$ get projects</p>
    <ul class="mini-projects">
      {
        spotlight.map((project) => (
          <li>
            <a class="mini-project" href="/projects/">
              <span class="mini-logo" style={`--h: ${project.hue}`}>
                <img src={`/logos/${project.logo}`} alt={`${project.title} 로고`} loading="lazy" decoding="async" />
              </span>
              <span class="mini-body">
                <span class="mini-title">{project.title}</span>
                <span class="mini-kind">{project.kind}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="status-more" href="/projects/">전체 프로젝트 →</a>
  </div>

  <div class="status-block">
    <p class="status-label">$ get certs</p>
    <ul class="mini-certs">
      {
        certifications.map((item) => (
          <li>
            <a class="mini-cert" href="/about/#certs" title={item.name}>
              <img src={item.image.replace(/\.png$/i, '.webp')} alt={item.name} width="113" height="85" loading="lazy" decoding="async" />
              <span>{item.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cpu = 12;
  const basePods = Number(document.querySelector('[data-live-pods]')?.textContent) || 36;
  const tick = () => {
    const now = fmt.format(new Date());
    document.querySelectorAll<HTMLElement>('[data-kst-clock]').forEach((el) => { el.textContent = now; });
    if (reduce || document.hidden) return;
    cpu = Math.min(22, Math.max(6, cpu + (Math.random() > 0.5 ? 1 : -1)));
    const pods = basePods + (Math.random() > 0.7 ? 1 : Math.random() > 0.45 ? 0 : -1);
    document.querySelectorAll<HTMLElement>('[data-live-cpu]').forEach((el) => { el.textContent = `${cpu}%`; });
    document.querySelectorAll<HTMLElement>('[data-live-pods]').forEach((el) => { el.textContent = String(pods); });
  };
  if (!window.__sunjaeStatus) {
    window.__sunjaeStatus = true;
    tick();
    setInterval(tick, 1600);
  }
</script>
