---
import { nav, site } from '../config';

const path = Astro.url.pathname;
function current(href: string) {
  return path === href || path.startsWith(href);
}

const commands: Record<string, string> = {
  '/blog/': 'get posts',
  '/archive/': 'get archive',
  '/categories/': 'get categories',
  '/tags/': 'get tags',
  '/search/': 'grep',
  '/about/': 'describe me',
};
---

<a class="skip" href="#content">본문으로 건너뛰기</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.title} 홈`}>
      <span class="ps1">
        <span class="ps1-user">sunjae</span><span class="ps1-at">@</span><span class="ps1-host">k8s</span><span class="ps1-path">:~</span><span class="ps1-sigil">$</span>
      </span>
      <span class="caret" aria-hidden="true"></span>
      <span class="brand-note"># {site.title}</span>
    </a>
    <nav id="site-nav" class="site-nav" aria-label="주요">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? 'page' : undefined} title={item.label}>
            <span class="nav-cmd">{commands[item.href] ?? item.label}</span>
            <span class="nav-ko">{item.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <button class="icon-button" id="theme-toggle" type="button" aria-label="색 테마 전환">
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="currentColor" d="M14.5 2.4a.8.8 0 0 1 .2.9 7.2 7.2 0 0 0 6 9.8.8.8 0 0 1 .2 1.5A8.8 8.8 0 1 1 13.5 2a.8.8 0 0 1 1 .4Z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <path d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="bars" aria-hidden="true"></span>
        <span class="sr-only">메뉴</span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navEl = document.getElementById('site-nav');
  const themeButton = document.getElementById('theme-toggle');

  const themeName = () => (document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark');

  const syncThemeChrome = () => {
    const dark = themeName() === 'dark';
    themeButton?.setAttribute('aria-label', dark ? '밝은 테마로 전환' : '어두운 테마로 전환');
    themeButton?.setAttribute('aria-pressed', dark ? 'true' : 'false');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0e1110' : '#f4f7f5');
  };

  const syncGiscus = (theme: string) => {
    document.querySelector('script[src*="giscus.app/client.js"]')?.setAttribute('data-theme', theme);
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  };

  syncThemeChrome();

  themeButton?.addEventListener('click', () => {
    const next = themeName() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncThemeChrome();
    syncGiscus(next);
  });

  const closeNav = (focusToggle = false) => {
    navEl?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    if (focusToggle) toggle?.focus();
  };

  toggle?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  navEl?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeNav());
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navEl?.classList.contains('is-open')) closeNav(true);
  });

  document.addEventListener('click', (event) => {
    if (!navEl?.classList.contains('is-open')) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (navEl.contains(target) || toggle?.contains(target)) return;
    closeNav();
  });
</script>
