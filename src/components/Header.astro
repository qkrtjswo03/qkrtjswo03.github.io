---
import { nav, site } from '../config';
import { countTerms, getPosts, terminalPostIndex, termUrl } from '../lib/posts';
import Terminal from './Terminal.astro';
import StatusPanel from './StatusPanel.astro';

interface Props {
  source?: string;
}

const { source } = Astro.props;
const path = Astro.url.pathname;
const allPosts = await getPosts();
const topics = countTerms(allPosts, 'categories');
const year = new Date().getFullYear();
const showTermDock = !path.startsWith('/terminal');
const showStatusRail = !path.startsWith('/terminal');
const termPosts = showTermDock ? terminalPostIndex(allPosts) : [];

function current(href: string) {
  return path === href || path.startsWith(href);
}

const commands: Record<string, string> = {
  '/blog/': 'get posts',
  '/projects/': 'get projects',
  '/archive/': 'get archive',
  '/about/': 'describe me',
};
---

<a class="skip" href="#content">본문으로 건너뛰기</a>
<div class:list={["app-shell", showTermDock && "has-term-dock"]}>
<div class:list={["console", showStatusRail && "has-status-rail"]}>
  <aside class="rail">
    <div class="rail-head">
      <a class="brand" href="/" aria-label={`${site.title} 홈`}>
        <span class="ps1">
          <span class="ps1-user">sunjae</span><span class="ps1-at">@</span><span class="ps1-host">k8s</span><span class="ps1-path">:~</span><span class="ps1-sigil">$</span>
        </span>
        <span class="caret" aria-hidden="true"></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="bars" aria-hidden="true"></span>
        <span class="sr-only">메뉴</span>
      </button>
    </div>
    <div class="rail-body" id="site-nav">
      <div class="rail-intro">
        <p class="rail-title"><a href="/">{site.title}</a></p>
        <p class="rail-lede">{site.tagline}</p>
        <a
          class="repo-link"
          href="https://github.com/qkrtjswo03?tab=repositories"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"
              d="M4 7.5 12 4l8 3.5v9L12 20l-8-3.5v-9Z"></path>
            <path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 11.2V20M4.2 7.7 12 11.2l7.8-3.5"></path>
          </svg>
          저장소
        </a>
      </div>
      <nav class="site-nav" aria-label="주요">
        {
          nav.map((item) => {
            const command = commands[item.href];
            return (
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined} title={item.label}>
                <span class="nav-cmd">{command ?? item.label}</span>
                {command && <span class="nav-ko">{item.label}</span>}
              </a>
            );
          })
        }
      </nav>
      {
        topics.length > 0 && (
          <ul class="topic-list rail-topics">
            {topics.map(([topic, count]) => (
              <li>
                <a href={termUrl('categories', topic)}>
                  {topic} <span class="count">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="rail-foot">
        <nav class="rail-links" aria-label="바닥">
          <a href="/license/">저작권</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/contact/">문의</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="rail-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-word">Ready</span>
          <span class="dim">© {year} {site.author} · All Rights Reserved</span>
        </p>
      </div>
    </div>
  </aside>
  <main id="content" class="page">
    <slot />
    {
      source && (
        <p class="page-source">
          {source.includes('src/content/blog/') ? '이 글은' : '이 페이지는'}{' '}
          <code>{source}</code>에서 고칩니다.
        </p>
      )
    }
  </main>
  {showStatusRail && <StatusPanel posts={allPosts} />}
</div>
{
  showTermDock && (
    <aside class="term-dock" id="term-dock" aria-label="웹 터미널" data-collapsed="true" transition:persist="vim-dock">
      <div
        class="term-dock-resize"
        id="term-dock-resize"
        role="separator"
        aria-orientation="horizontal"
        aria-label="터미널 높이 조절"
        title="드래그해서 높이 조절"
      ></div>
      <div class="term-dock-head">
        <span class="term-dock-title">$ vim</span>
        <div class="term-dock-actions">
          <button
            type="button"
            class="term-dock-lock"
            id="term-dock-lock"
            aria-pressed="false"
            aria-label="터미널 고정 해제됨"
            title="고정 (호버 없이 펼침 유지)"
          >
            <svg class="term-dock-lock-icon term-dock-lock-icon--unlocked" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M8 11V8a4 4 0 0 1 7.5-1.9"></path>
              <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
              <circle cx="12" cy="16" r="1.2" fill="currentColor"></circle>
            </svg>
            <svg class="term-dock-lock-icon term-dock-lock-icon--locked" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" hidden>
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M8 11V8a4 4 0 0 1 8 0v3"></path>
              <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
              <circle cx="12" cy="16" r="1.2" fill="currentColor"></circle>
            </svg>
            <span class="term-dock-lock-label">잠금</span>
          </button>
          <a href="#term-new-post">new post</a>
          <a href="#term-login">login</a>
          <a href="/terminal/">전체 화면</a>
        </div>
      </div>
      <Terminal posts={termPosts} variant="panel" />
    </aside>
  )
}
</div>

<script>
  const closeNav = (focusToggle = false) => {
    const rail = document.querySelector('.rail');
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    rail?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    if (focusToggle) toggle?.focus();
  };

  if (!window.__sunjaeChrome) {
    window.__sunjaeChrome = true;
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.querySelector('.rail')?.classList.contains('is-open')) closeNav(true);
    });
    document.addEventListener('click', (event) => {
      const rail = document.querySelector('.rail');
      if (!rail?.classList.contains('is-open')) return;
      const target = event.target;
      if (!(target instanceof Node) || rail.contains(target)) return;
      closeNav();
    });
  }

  const bindChrome = () => {
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const rail = document.querySelector('.rail');
  const navEl = document.getElementById('site-nav');
  if (toggle && toggle.dataset.navBound !== '1') {
    toggle.dataset.navBound = '1';
    toggle.addEventListener('click', () => {
      const open = rail?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
  navEl?.querySelectorAll('a').forEach((link) => {
    if (link.dataset.navBound === '1') return;
    link.dataset.navBound = '1';
    link.addEventListener('click', () => closeNav());
  });

  const dock = document.getElementById('term-dock');
  const lockBtn = document.getElementById('term-dock-lock');
  const resizeHandle = document.getElementById('term-dock-resize');
  const LOCK_KEY = 'blog-term-dock-locked';
  const HEIGHT_KEY = 'blog-term-dock-h';
  const shell = document.querySelector<HTMLElement>('.app-shell.has-term-dock');
  const MIN_H = 160;
  const maxH = () => Math.max(MIN_H + 40, Math.floor(window.innerHeight * 0.72));

  const applyDockHeight = (px: number) => {
    if (!shell) return;
    const next = Math.min(maxH(), Math.max(MIN_H, Math.round(px)));
    shell.style.setProperty('--term-dock-expanded-h', `${next}px`);
    return next;
  };

  if (shell) {
    const saved = Number(localStorage.getItem(HEIGHT_KEY));
    if (Number.isFinite(saved) && saved >= MIN_H) applyDockHeight(saved);
  }

  if (dock && lockBtn && dock.dataset.dockBound !== '1') {
    dock.dataset.dockBound = '1';
    let locked = localStorage.getItem(LOCK_KEY) === '1';

    const dockFocused = () => {
      const active = document.activeElement;
      return active instanceof Node && dock.contains(active);
    };

    const syncDock = () => {
      const open = locked || dock.matches(':hover') || dockFocused() || dock.classList.contains('is-resizing');
      dock.classList.toggle('is-open', open);
      dock.classList.toggle('is-locked', locked);
      dock.dataset.collapsed = open ? 'false' : 'true';
      lockBtn.setAttribute('aria-pressed', locked ? 'true' : 'false');
      lockBtn.setAttribute('aria-label', locked ? '터미널 고정됨' : '터미널 고정 해제됨');
      lockBtn.title = locked ? '고정 해제' : '고정 (호버 없이 펼침 유지)';
      const unlocked = lockBtn.querySelector('.term-dock-lock-icon--unlocked');
      const lockedIcon = lockBtn.querySelector('.term-dock-lock-icon--locked');
      unlocked?.toggleAttribute('hidden', locked);
      lockedIcon?.toggleAttribute('hidden', !locked);
    };

    lockBtn.addEventListener('click', (event) => {
      event.preventDefault();
      locked = !locked;
      localStorage.setItem(LOCK_KEY, locked ? '1' : '0');
      syncDock();
    });

    dock.addEventListener('mouseenter', syncDock);
    dock.addEventListener('mouseleave', syncDock);
    dock.addEventListener('focusin', syncDock);
    dock.addEventListener('focusout', () => {
      window.setTimeout(syncDock, 0);
    });

    if (resizeHandle && shell) {
      resizeHandle.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        const pointerId = event.pointerId;
        resizeHandle.setPointerCapture(pointerId);
        dock.classList.add('is-resizing');
        document.body.classList.add('is-term-resizing');
        locked = true;
        localStorage.setItem(LOCK_KEY, '1');
        syncDock();

        const onMove = (moveEvent: PointerEvent) => {
          const next = window.innerHeight - moveEvent.clientY;
          applyDockHeight(next);
        };
        const onUp = () => {
          resizeHandle.releasePointerCapture(pointerId);
          resizeHandle.removeEventListener('pointermove', onMove);
          resizeHandle.removeEventListener('pointerup', onUp);
          resizeHandle.removeEventListener('pointercancel', onUp);
          dock.classList.remove('is-resizing');
          document.body.classList.remove('is-term-resizing');
          const computed = getComputedStyle(shell).getPropertyValue('--term-dock-expanded-h').trim();
          const px = Number.parseFloat(computed);
          if (Number.isFinite(px)) localStorage.setItem(HEIGHT_KEY, String(Math.round(px)));
          syncDock();
        };
        resizeHandle.addEventListener('pointermove', onMove);
        resizeHandle.addEventListener('pointerup', onUp);
        resizeHandle.addEventListener('pointercancel', onUp);
      });
    }

    syncDock();
  }
  };

  bindChrome();
  document.addEventListener('astro:page-load', bindChrome);
</script>
