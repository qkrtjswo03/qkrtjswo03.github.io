---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Cmd from '../components/Cmd.astro';
import Comments from '../components/Comments.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CopyGuard from '../components/CopyGuard.astro';
import ImageZoom from '../components/ImageZoom.astro';
import OwnerActions from '../components/OwnerActions.astro';
import { blogFilePath, deletePostUrl, editPostUrl } from '../lib/github';
import { site } from '../config';
import { goatcounterCode } from '../lib/ads';
import { absoluteUrl, DEFAULT_OG_IMAGE, metaDescription, postOgPath } from '../lib/seo';
import {
  formatDate,
  postSlug,
  postUrl,
  readingMinutes,
  seriesLabel,
  seriesTitle,
  termUrl,
  type BlogPost,
} from '../lib/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings: Heading[];
  older?: BlogPost | null;
  newer?: BlogPost | null;
  seriesList?: BlogPost[];
}

const { post, headings, older = null, newer = null, seriesList = [] } = Astro.props;
const seriesIndex = seriesList.findIndex((item) => postSlug(item.id) === postSlug(post.id));
const inSeries = seriesIndex >= 0 && seriesList.length > 1;
const prevPost = inSeries ? (seriesIndex > 0 ? seriesList[seriesIndex - 1] : null) : older;
const nextPost = inSeries
  ? seriesIndex < seriesList.length - 1
    ? seriesList[seriesIndex + 1]
    : null
  : newer;
const prevLabel = inSeries ? '이전' : '이전 글';
const nextLabel = inSeries ? '다음' : '다음 글';
const gc = goatcounterCode();
const categories = post.data.categories ?? [];
const tags = post.data.tags ?? [];
const locked = post.data.locked === true;
const minutes = readingMinutes(locked ? post.data.description : (post.body ?? post.data.description));
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = absoluteUrl(postUrl(post));
const description = metaDescription({
  locked,
  description: post.data.description,
  body: locked ? '' : post.body,
});
const image = locked ? DEFAULT_OG_IMAGE : postOgPath(postSlug(post.id));
const metaTags = locked ? [] : tags;
const modified = post.data.updatedDate ?? post.data.pubDate;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: 'ko-KR',
    author: { '@type': 'Person', name: site.author, url: absoluteUrl('/about/') },
    publisher: { '@type': 'Person', name: site.author, url: site.url },
    mainEntityOfPage: canonical,
    url: canonical,
    image: absoluteUrl(image),
    isAccessibleForFree: !locked,
    ...(locked ? {} : { keywords: tags.join(', ') }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '글', item: absoluteUrl('/blog/') },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  image={image}
  imageAlt={locked ? site.title : post.data.title}
  publishedTime={post.data.pubDate}
  modifiedTime={modified}
  tags={metaTags}
  noindex={locked}
  jsonLd={jsonLd}
  source={`src/content/blog/${postSlug(post.id)}.md`}
>
  <ReadingProgress />
  <article class="post-layout" data-copy-guard>
    {
      inSeries && (
        <nav class="series-box" id="series" aria-label={`${seriesTitle(post.data.series ?? '')} 목차`}>
          <p class="series-kicker">
            {seriesTitle(post.data.series ?? '')}
            <span class="count">
              {seriesIndex + 1}/{seriesList.length}
            </span>
          </p>
          <ol>
            {seriesList.map((item) => (
              <li>
                <a href={postUrl(item)} aria-current={postSlug(item.id) === postSlug(post.id) ? 'page' : undefined}>
                  <span class="series-num">{item.data.seriesOrder}</span>
                  {seriesLabel(item)}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <header class="post-header describe-panel">
      <div class="list-head">
        <Cmd command={`kubectl describe post/${postSlug(post.id)}`} />
        <OwnerActions
          links={[
            { href: editPostUrl(post), label: 'edit' },
            { href: deletePostUrl(post), label: 'delete' },
          ]}
        />
      </div>
      <dl class="describe-list">
        <div>
          <dt title="이름">Name</dt>
          <dd>
            <div class="post-title-row">
              <h1>{post.data.title}</h1>
              <span
                class:list={['post-lock-badge', post.data.locked ? 'is-locked' : 'is-open']}
                role="status"
                title={post.data.locked ? '잠긴 글' : '공개된 글'}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d={post.data.locked ? 'M8 11V8a4 4 0 0 1 8 0v3' : 'M8 11V8a4 4 0 0 1 8 0'} />
                </svg>
                {post.data.locked ? '잠김' : '공개'}
              </span>
            </div>
          </dd>
        </div>
        <div>
          <dt title="주제">Categories</dt>
          <dd>
            {
              categories.length > 0 ? (
                <span class="chip-row">
                  {categories.map((category) => (
                    <a class="tag-pill" href={termUrl('categories', category)}>
                      {category}
                    </a>
                  ))}
                </span>
              ) : (
                <span class="none">&lt;none&gt;</span>
              )
            }
          </dd>
        </div>
        <div>
          <dt title="태그">Labels</dt>
          <dd>
            {
              tags.length > 0 ? (
                <span class="chip-row">
                  {tags.map((tag) => (
                    <a class="tag-pill" href={termUrl('tags', tag)}>
                      {tag}
                    </a>
                  ))}
                </span>
              ) : (
                <span class="none">&lt;none&gt;</span>
              )
            }
          </dd>
        </div>
        <div>
          <dt title="작성일">Created</dt>
          <dd>
            <time class="meta-mono" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </dd>
        </div>
        {
          post.data.updatedDate && (
            <div>
              <dt title="수정일">Updated</dt>
              <dd>
                <time class="meta-mono" datetime={post.data.updatedDate.toISOString()}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </dd>
            </div>
          )
        }
        <div>
          <dt title="읽기 시간">Reading</dt>
          <dd><span class="meta-mono">{minutes}분</span></dd>
        </div>
        {gc && (
          <div data-gc-path={postUrl(post)} hidden>
            <dt title="조회수">Views</dt>
            <dd><span class="meta-mono">조회 <span data-gc-count>—</span></span></dd>
          </div>
        )}
      </dl>
      <p class="lede">{description}</p>
    </header>
    <div class="post-main">
      {post.data.locked && (
        <p class="post-lock-pending" data-locked-pending>
          잠긴 글입니다. 저장소 주인만 본문을 볼 수 있습니다.
          <button type="button" class="post-lock-btn" data-locked-open>주인 인증</button>
        </p>
      )}
      <div
        class="post-lock-body"
        data-post-lock-body
        data-locked-article={post.data.locked ? '' : undefined}
        data-path={post.data.locked ? blogFilePath(post) : undefined}
        hidden={post.data.locked}
      >
      {
        !post.data.locked && post.data.sample && (
          <p class="sample-banner">
            <strong>예시 글입니다.</strong> 지울 때는 <code>src/content/blog/{postSlug(post.id)}.md</code> 파일을
            삭제하세요. 내용은 남기고 이 안내만 없애려면 frontmatter의 <code>sample</code>을 <code>false</code>로
            바꾸면 됩니다.
          </p>
        )
      }
      {
        !post.data.locked && post.data.heroImage?.trim() && (
          <figure class="hero">
            <img
              src={post.data.heroImage}
              alt={post.data.heroAlt || post.data.title}
              width="1200"
              height="675"
            />
          </figure>
        )
      }
      <div class="prose" data-locked-prose={post.data.locked ? '' : undefined}>
        {!post.data.locked && <slot />}
      </div>
      <AdSlot hidden={post.data.locked === true} />
      {
        tags.length > 0 && (
          <ul class="tag-row">
            {tags.map((tag) => (
              <li>
                <a class="tag-pill" href={termUrl('tags', tag)}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        (prevPost || nextPost) && (
          <nav class:list={['pager', { 'series-pager': inSeries }]} aria-label={inSeries ? '시리즈 이동' : '다른 글'}>
            {prevPost ? (
              <a href={postUrl(prevPost)}>
                <span>{prevLabel}</span>
                <strong>{inSeries ? seriesLabel(prevPost) : prevPost.data.title}</strong>
              </a>
            ) : (
              <span></span>
            )}
            {nextPost && (
              <a class="next" href={postUrl(nextPost)}>
                <span>{nextLabel}</span>
                <strong>{inSeries ? seriesLabel(nextPost) : nextPost.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }
      <Comments />
      </div>
    </div>
    <aside class="post-side">
      {
        toc.length > 0 && (
          <nav class="toc" aria-label="목차">
            <p>목차</p>
            <ol>
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? 'toc-sub' : undefined}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </article>
  <CopyGuard />
  <ImageZoom />
  <script>
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Backspace' || event.metaKey || event.ctrlKey || event.altKey) return;
      const t = event.target;
      if (t instanceof HTMLElement) {
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) || t.isContentEditable) return;
        if (t.closest('.term-shell')) return;
      }
      event.preventDefault();
      if (history.length > 1) history.back();
    });
  </script>
</BaseLayout>
