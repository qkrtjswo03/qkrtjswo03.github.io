---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Motion from '../components/Motion.astro';
import Header from '../components/Header.astro';
import LockGate from '../components/LockGate.astro';
import GcViews from '../components/GcViews.astro';
import { site } from '../config';
import { adsensePublisherId } from '../lib/ads';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: unknown;
  source?: string;
  preloadHero?: { href: string; imagesrcset?: string; imagesizes?: string };
}

const { title = site.title, description = site.description, source, preloadHero, ...rest } = Astro.props;
const documentTitle = title === site.title ? site.title : `${title} · ${site.title}`;
const showAds = Boolean(adsensePublisherId());
---

<!doctype html>
<html lang={site.lang} data-theme="dark">
  <head>
    <ClientRouter />
    <BaseHead title={documentTitle} description={description} preloadHero={preloadHero} {...rest} />
  </head>
  <body>
    <Motion />
    <LockGate />
    <Header source={source}>
      <slot />
    </Header>
    {
      showAds && (
        <script is:inline>
          (function () {
            function push() {
              var nodes = document.querySelectorAll('ins.adsbygoogle');
              for (var i = 0; i < nodes.length; i++) {
                if (nodes[i].getAttribute('data-adsbygoogle-status')) continue;
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              }
            }
            if (!window.__sunjaeAds) {
              window.__sunjaeAds = true;
              document.addEventListener('astro:page-load', push);
            }
            if (document.readyState === 'complete') push();
            else window.addEventListener('load', push);
          })();
        </script>
      )
    }
    <GcViews />
  </body>
</html>
